{
  "$schema": "https://unpkg.com/wrangler@4.160.0/config-schema.json",
  "name": "pc-lpm-bf26-d007-router",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // conta da zona cronogramadosfluentes.com.br
  "account_id": "1674537158620e3e2821c20c2f1dd48a",
  // Publicado em 25/11/2026 SEM rotas (versão 83c85e8b). As rotas foram criadas em 26/11/2026 pela API
  // (POST zones/:zone/workers/routes), uma página por vez, para não recriar rotas já no ar. Esta lista é o estado atual.
  // Um `wrangler deploy` com ela recria as 3 rotas (alguns segundos de 404 do WordPress), então só em horário de pouco tráfego.
  "routes": [
    { "pattern": "cronogramadosfluentes.com.br/pc-lpm-bf26v32*", "zone_name": "cronogramadosfluentes.com.br" },
    { "pattern": "cronogramadosfluentes.com.br/pc-lpm-bf26v34*", "zone_name": "cronogramadosfluentes.com.br" },
    { "pattern": "cronogramadosfluentes.com.br/pc-lpm-bf26v36*", "zone_name": "cronogramadosfluentes.com.br" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
