  // Publicado SEM rotas. Cada rota é criada pela API (POST zones/:zone/workers/routes), uma página por vez,
  // para não recriar rotas já no ar. Esta lista é o registro do estado atual (preenchida conforme as rotas entram).
  // Um `wrangler deploy` com rotas aqui recria todas (alguns segundos sem Worker), então só em horário de pouco tráfego.
  "routes": [],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
