{
  "$schema": "https://unpkg.com/wrangler@4.160.0/config-schema.json",
  "name": "pc-lpm-mgm-router",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // conta da zona cronogramadosfluentes.com.br
  "account_id": "1674537158620e3e2821c20c2f1dd48a",
  // Publicado em 26/11/2026 SEM rotas (versão 9b120409). A rota foi criada depois pela API
  // (POST zones/:zone/workers/routes), sem mexer nas outras 40 rotas da zona. Esta lista é o estado atual:
  //   cronogramadosfluentes.com.br/pc-lpm-mgmv1*  → id 822336f6c8774e0aad87e10d819caa4b (26/11/2026)
  // Para publicar código novo sem mexer na rota: `npx wrangler@4 versions upload` + `versions deploy <id>@100%`.
  // Um `wrangler deploy` com esta lista recria a rota (alguns segundos de 404 do WordPress), então só em horário de pouco tráfego.
  // Rollback (apaga só esta rota):
  //   curl -X DELETE "https://api.cloudflare.com/client/v4/zones/64725095c94dd484bf2e5416bda7d7d8/workers/routes/822336f6c8774e0aad87e10d819caa4b" \
  //     -H "Authorization: Bearer <token OAuth do wrangler>"
  //   e tirar a rota desta lista.
  "routes": [
    { "pattern": "cronogramadosfluentes.com.br/pc-lpm-mgmv1*", "zone_name": "cronogramadosfluentes.com.br" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
